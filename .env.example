# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Authentication settings
USE_AUTH=false

# FHIR Server Configuration
FHIR_SERVER=https://your-fhir-server.com/fhir/DEFAULT
FHIR_USERNAME=your_username
FHIR_PASSWORD=your_password

# Example for development:
# FHIR_SERVER=https://smile.sparked-fhir.com/ereq/fhir/DEFAULT
# FHIR_USERNAME=placer
# FHIR_PASSWORD=your_actual_password_here

# Australian Provider Directory — FHIR R4, no auth required
# Default: https://fhir-xrp.digitalhealth.gov.au/fhir (override to use a different instance)
# X-Request-ID UUID header is added automatically per request.
PD_SERVER=

# HCPD bulk export (Directory Import page) — FHIR Bulk Data $export.
# HCPD_EXPORT_SERVER defaults to PD_SERVER (or the SIT router) when empty.
HCPD_EXPORT_SERVER=
# SIT/connectathon: a pre-generated JWT with export scope (e.g. SIT-export.txt), inline or as a file path
HCPD_BEARER_TOKEN=
HCPD_BEARER_TOKEN_FILE=
# Production: OAuth client credentials via the Health Connect Authorisation Service (takes precedence)
HCPD_TOKEN_ENDPOINT=
HCPD_CLIENT_ID=
HCPD_CLIENT_SECRET=
HCPD_SCOPE=
# PUT entries per batch Bundle when importing into the referral FHIR server
HCPD_IMPORT_BATCH_SIZE=100

# AU Patient Summary Producer endpoint (Scenario 1, proposal 03)
# Defaults to FHIR_SERVER if the same server exposes $summary
PS_PRODUCER=


# Imaging appointment booking (Radiology Referral IG)
# Claim IG profiles (booking-schedule, booking-slot, referral-appointment) in meta.profile.
# Set false if the FHIR server rejects profiles it does not know.
CLAIM_BOOKING_PROFILES=true
# IANA timezone used to generate Slots and display booking times
BOOKING_TIMEZONE=Australia/Brisbane
# Opt-in live booking end-to-end test (tests/e2e_booking.py); leave empty to skip
FHIR_E2E_URL=


# Code Search 
CODESEARCH_API_ENDPOINT=
CODESEARCH_TOKEN_ENDPOINT=
CODESEARCH_CLIENT_ID=
CODESEARCH_CLIENT_SECRET=
CODESEARCH_CONTENT_TYPE=


# Locator service API Keys (geospace.com.au)
GNAF_CONSUMER_KEY=
GNAF_CONSUMER_SECRET=
